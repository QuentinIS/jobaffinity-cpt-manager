msgid "Roles allowed to manage the post type"
msgstr "Rôles autorisés à gérer le CPT"

#: includes/class-ccptm-admin.php:401
msgid "Administrator: full access."
msgstr "Administrateur : accès complet."

#: includes/class-ccptm-admin.php:402
msgid "Editor: create, edit and publish all content."
msgstr "Éditeur : créer, modifier et publier tous les contenus."

#: includes/class-ccptm-admin.php:403
msgid "Author: create and manage their own content."
msgstr "Auteur : créer et gérer ses propres contenus."

